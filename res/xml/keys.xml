<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <Preference
        android:selectable="false"
        android:summary="@string/keys_intro" />

    <PreferenceCategory
        android:key="cat_buttons"
        android:title="@string/cat_buttons" />

    <PreferenceCategory android:title="@string/cat_system_keys">
        <ListPreference
            android:key="end_button"
            android:title="@string/end_button"
            android:entries="@array/end_button_entries"
            android:entryValues="@array/end_button_values"
            android:persistent="false"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            android:key="home_long_press_shade"
            android:title="@string/home_shade"
            android:summary="@string/home_shade_summary"
            android:defaultValue="true" />
        <Preference
            android:selectable="false"
            android:summary="@string/soft_keys_summary" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/cat_lock_lid">
        <SwitchPreferenceCompat
            android:key="lid_answer"
            android:title="@string/lid_answer"
            android:defaultValue="false" />
        <SwitchPreferenceCompat
            android:key="lid_end"
            android:title="@string/lid_end"
            android:summary="@string/lid_end_summary"
            android:defaultValue="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/cat_text_input">
        <Preference
            android:key="t9"
            android:title="@string/t9"
            android:summary="@string/t9_summary" />
    </PreferenceCategory>
</PreferenceScreen>
