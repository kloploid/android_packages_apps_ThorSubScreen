<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.android.settingslib.widget.MainSwitchPreference
        android:key="enabled"
        android:title="@string/use_outer_screen"
        android:defaultValue="true" />

    <org.thor2.subscreen.PreviewPreference android:key="preview" />

    <Preference
        android:key="show_now"
        android:title="@string/show_now"
        android:summary="@string/show_now_summary"
        android:dependency="enabled" />

    <PreferenceCategory android:title="@string/cat_clock" android:dependency="enabled">
        <ListPreference
            android:key="clock_style"
            android:title="@string/clock_style"
            android:entries="@array/clock_style_entries"
            android:entryValues="@array/clock_style_values"
            android:defaultValue="digital"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            android:key="clock_format"
            android:title="@string/clock_format"
            android:entries="@array/clock_format_entries"
            android:entryValues="@array/clock_format_values"
            android:defaultValue="system"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            android:key="show_seconds"
            android:title="@string/show_seconds"
            android:summary="@string/show_seconds_summary"
            android:defaultValue="false" />
        <SwitchPreferenceCompat
            android:key="show_date"
            android:title="@string/show_date"
            android:defaultValue="true" />
        <ListPreference
            android:key="accent_color"
            android:title="@string/accent_color"
            android:entries="@array/accent_entries"
            android:entryValues="@array/accent_values"
            android:defaultValue="white"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            android:key="background"
            android:title="@string/background"
            android:entries="@array/background_entries"
            android:entryValues="@array/background_values"
            android:defaultValue="black"
            app:useSimpleSummaryProvider="true" />
        <Preference
            android:key="pick_photo"
            android:title="@string/pick_photo"
            android:summary="@string/pick_photo_summary" />
        <EditTextPreference
            android:key="signature"
            android:title="@string/signature"
            android:dialogMessage="@string/signature_hint"
            android:defaultValue=""
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/cat_status" android:dependency="enabled">
        <ListPreference
            android:key="battery_style"
            android:title="@string/battery_style"
            android:entries="@array/battery_entries"
            android:entryValues="@array/battery_values"
            android:defaultValue="icon_percent"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            android:key="notif_icons"
            android:title="@string/notif_icons"
            android:summary="@string/notif_icons_summary"
            android:defaultValue="true" />
        <SwitchPreferenceCompat
            android:key="show_missed"
            android:title="@string/show_missed"
            android:defaultValue="true" />
        <SwitchPreferenceCompat
            android:key="show_steps"
            android:title="@string/show_steps"
            android:summary="@string/show_steps_summary"
            android:defaultValue="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/cat_pages" android:dependency="enabled">
        <Preference
            android:selectable="false"
            android:summary="@string/pages_summary" />
        <SwitchPreferenceCompat
            android:key="page_notifications"
            android:title="@string/page_notifications"
            android:defaultValue="true" />
        <SwitchPreferenceCompat
            android:key="notif_text"
            android:title="@string/notif_text"
            android:summary="@string/notif_text_summary"
            android:defaultValue="false"
            android:dependency="page_notifications" />
        <SwitchPreferenceCompat
            android:key="page_music"
            android:title="@string/page_music"
            android:summary="@string/page_music_summary"
            android:defaultValue="true" />
        <SwitchPreferenceCompat
            android:key="page_pet"
            android:title="@string/page_pet"
            android:summary="@string/page_pet_summary"
            android:defaultValue="true" />
        <SwitchPreferenceCompat
            android:key="page_eightball"
            android:title="@string/page_eightball"
            android:summary="@string/page_eightball_summary"
            android:defaultValue="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/cat_wake" android:dependency="enabled">
        <SwitchPreferenceCompat
            android:key="wake_lid"
            android:title="@string/wake_lid"
            android:defaultValue="true" />
        <SwitchPreferenceCompat
            android:key="wake_sos"
            android:title="@string/wake_sos"
            android:summary="@string/wake_sos_summary"
            android:defaultValue="true" />
        <SwitchPreferenceCompat
            android:key="torch_double_sos"
            android:title="@string/torch_double_sos"
            android:summary="@string/torch_double_sos_summary"
            android:defaultValue="true"
            android:dependency="wake_sos" />
        <SwitchPreferenceCompat
            android:key="wake_volume"
            android:title="@string/wake_volume"
            android:defaultValue="false" />
        <SwitchPreferenceCompat
            android:key="wake_notifications"
            android:title="@string/wake_notifications"
            android:defaultValue="true" />
        <SwitchPreferenceCompat
            android:key="wake_charging"
            android:title="@string/wake_charging"
            android:defaultValue="true" />
        <SwitchPreferenceCompat
            android:key="charging_anim"
            android:title="@string/charging_anim"
            android:defaultValue="true"
            android:dependency="wake_charging" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/cat_display" android:dependency="enabled">
        <ListPreference
            android:key="timeout"
            android:title="@string/timeout"
            android:entries="@array/timeout_entries"
            android:entryValues="@array/timeout_values"
            android:defaultValue="8"
            app:useSimpleSummaryProvider="true" />
        <SeekBarPreference
            android:key="brightness"
            android:title="@string/brightness"
            android:max="100"
            app:min="5"
            android:defaultValue="60"
            app:showSeekBarValue="true" />
        <SwitchPreferenceCompat
            android:key="night_mode"
            android:title="@string/night_mode"
            android:summary="@string/night_mode_summary"
            android:defaultValue="false" />
        <ListPreference
            android:key="night_start"
            android:title="@string/night_start"
            android:entries="@array/hour_entries"
            android:entryValues="@array/hour_values"
            android:defaultValue="23"
            android:dependency="night_mode"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            android:key="night_end"
            android:title="@string/night_end"
            android:entries="@array/hour_entries"
            android:entryValues="@array/hour_values"
            android:defaultValue="7"
            android:dependency="night_mode"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>
</PreferenceScreen>
